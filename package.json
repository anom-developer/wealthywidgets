{
  "name": "wealthywidgets",
  "version": "2.2.0",
  "description": "🧩 Premium UI & Live Data Widgets with Binance crypto ticker, Open-Meteo weather, zero-build Web Components, Notion embeds & PWA support",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs && node scripts/build-css.js",
    "dev": "rollup -c rollup.config.mjs -w",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "storybook": "echo \"Static docs site is in docs/index.html — open directly in browser\"",
    "build-storybook": "echo \"Static docs site is in docs/index.html \u2014 no build needed\"",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\""
  },
  "keywords": [
    "react",
    "widgets",
    "web-components",
    "notion",
    "notion-embed",
    "ticker",
    "crypto-ticker",
    "binance",
    "weather-widget",
    "open-meteo",
    "finance-widget",
    "pwa",
    "typescript",
    "ui-components",
    "design-system",
    "zero-build",
    "embeddable"
  ],
  "author": "WealthyWidgets Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anom-developer/wealthywidgets.git"
  },
  "bugs": {
    "url": "https://github.com/anom-developer/wealthywidgets/issues"
  },
  "homepage": "https://github.com/anom-developer/wealthywidgets#readme",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "sass": "^1.80.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
